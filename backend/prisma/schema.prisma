datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DRIVER
  FLEET_MANAGER
  HR
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum ChecklistType {
  ENTRY
  EXIT
}

enum ClockingType {
  IN
  OUT
  LUNCH_OUT
  LUNCH_IN
}

model Tenant {
  id                 String               @id @default(uuid())
  name               String
  cnpj               String?              @unique
  status             String               @default("ACTIVE")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  branches           Branch[]
  users              User[]
  vehicles           Vehicle[]
  checklistTemplates ChecklistTemplate[]
  vehicleChecklists  VehicleChecklist[]
  vehicleUsages      VehicleUsage[]
  timeClockings      TimeClocking[]
  workShifts         WorkShift[]
  auditLogs          AuditLog[]
  facialEmbeddings   FacialEmbedding[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  city      String?
  state     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users    User[]
  vehicles Vehicle[]

  @@map("branches")
}

model User {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  branchId      String?   @map("branch_id")
  name          String
  cpf           String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(DRIVER)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  facialEmbedding  FacialEmbedding?
  vehicleChecklists VehicleChecklist[]
  vehicleUsages    VehicleUsage[]
  timeClockings    TimeClocking[]
  workShifts       WorkShift[]
  auditLogs        AuditLog[]

  @@map("users")
}

model FacialEmbedding {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  userId          String   @unique @map("user_id")
  embeddingVector Json     @map("embedding_vector") // Array numérico de floats do MobileFaceNet
  consentGiven    Boolean  @default(false) @map("consent_given")
  consentAt       DateTime? @map("consent_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("facial_embeddings")
}

model Vehicle {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  branchId       String?       @map("branch_id")
  plate          String        @unique
  brand          String
  model          String
  year           Int
  status         VehicleStatus @default(AVAILABLE)
  currentMileage Int           @default(0) @map("current_mileage")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicleChecklists VehicleChecklist[]
  vehicleUsages     VehicleUsage[]

  @@map("vehicles")
}

model ChecklistTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  items     Json     // Schema e lista de itens inspecionados
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("checklist_templates")
}

model VehicleChecklist {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  vehicleId   String        @map("vehicle_id")
  driverId    String        @map("driver_id")
  type        ChecklistType
  mileage     Int
  itemsResult Json          @map("items_result")
  photoUrls   Json?         @map("photo_urls")
  observation String?
  hasProblem  Boolean       @default(false) @map("has_problem")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver       User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entryUsages  VehicleUsage[] @relation("EntryChecklist")
  exitUsages   VehicleUsage[] @relation("ExitChecklist")

  @@map("vehicle_checklists")
}

model VehicleUsage {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  vehicleId            String    @map("vehicle_id")
  driverId             String    @map("driver_id")
  entryChecklistId     String    @map("entry_checklist_id")
  exitChecklistId      String?   @map("exit_checklist_id")
  startTime            DateTime  @default(now()) @map("start_time")
  endTime              DateTime? @map("end_time")
  lunchStartTime       DateTime? @map("lunch_start_time")
  lunchEndTime         DateTime? @map("lunch_end_time")
  totalLunchMinutes    Int?      @map("total_lunch_minutes")
  totalDurationMinutes Int?      @map("total_duration_minutes")
  totalDistanceKm      Int?      @map("total_distance_km")
  createdAt            DateTime  @default(now()) @map("created_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver         User             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entryChecklist VehicleChecklist @relation("EntryChecklist", fields: [entryChecklistId], references: [id])
  exitChecklist  VehicleChecklist? @relation("ExitChecklist", fields: [exitChecklistId], references: [id])

  @@map("vehicle_usages")
}

model TimeClocking {
  id                   String       @id @default(uuid())
  tenantId             String       @map("tenant_id")
  userId               String       @map("user_id")
  type                 ClockingType
  timestamp            DateTime     @default(now())
  isOffline            Boolean      @default(false) @map("is_offline")
  facialVerified       Boolean      @default(false) @map("facial_verified")
  matchConfidence      Float?       @map("match_confidence")
  manualFallbackReason String?      @map("manual_fallback_reason")
  latitude             Float?
  longitude            Float?
  createdAt            DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_clockings")
}

model WorkShift {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  userId             String   @map("user_id")
  shiftDate          DateTime @map("shift_date")
  totalWorkMinutes   Int      @default(0) @map("total_work_minutes")
  totalLunchMinutes  Int      @default(0) @map("total_lunch_minutes")
  isComplete         Boolean  @default(false) @map("is_complete")
  hasAlerts          Boolean  @default(false) @map("has_alerts")
  alertDetails       String?  @map("alert_details")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, shiftDate])
  @@map("work_shifts")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  timestamp  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
