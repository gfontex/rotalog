// ROTALOG - Prisma Schema com Persistencia em Disco (SQLite / PostgreSQL)
// Gestao de Frotas e Tropas Operacionais com Checklist e Ponto CLT

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                 String               @id @default(uuid())
  name               String               @unique // Nome da Empresa / Base (Ex: "MK Seguranca")
  code               String?              @unique // Codigo identificador unico
  cnpj               String?
  status             String               @default("ACTIVE")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  branches           Branch[]
  users              User[]
  vehicles           Vehicle[]
  checklistTemplates ChecklistTemplate[]
  vehicleChecklists  VehicleChecklist[]
  vehicleUsages      VehicleUsage[]
  timeClockings      TimeClocking[]
  auditLogs          AuditLog[]
}

model Branch {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  city      String
  state     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users     User[]
  vehicles  Vehicle[]
}

model User {
  id                 String             @id @default(uuid())
  tenantId           String
  branchId           String?
  name               String
  cpf                String             @unique
  email              String             @unique
  passwordHash       String             // Senha criptografada gerada pelo gestor
  role               String             @default("DRIVER") // "ADMIN" | "FLEET_MANAGER" | "DRIVER"
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  checklists         VehicleChecklist[]
  usages             VehicleUsage[]
  timeClockings      TimeClocking[]
  auditLogs          AuditLog[]
}

model Vehicle {
  id             String             @id @default(uuid())
  tenantId       String
  branchId       String?
  plate          String             @unique
  brand          String
  model          String
  year           Int
  status         String             @default("AVAILABLE") // "AVAILABLE" | "IN_USE" | "MAINTENANCE"
  currentMileage Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  checklists     VehicleChecklist[]
  usages         VehicleUsage[]
}

model ChecklistTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  items     String   // JSON string com itens a verificar
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model VehicleChecklist {
  id           String         @id @default(uuid())
  tenantId     String
  vehicleId    String
  driverId     String
  type         String         // "ENTRY" | "EXIT"
  mileage      Int
  itemsResult  String         // JSON string
  observation  String?
  hasProblem   Boolean        @default(false)
  photoUrls    String?
  createdAt    DateTime       @default(now())

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver       User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entryUsages  VehicleUsage[] @relation("EntryChecklist")
  exitUsages   VehicleUsage[] @relation("ExitChecklist")
}

model VehicleUsage {
  id                   String        @id @default(uuid())
  tenantId             String
  vehicleId            String
  driverId             String
  entryChecklistId     String?
  exitChecklistId      String?
  startTime            DateTime      @default(now())
  endTime              DateTime?
  lunchStartTime       DateTime?
  lunchEndTime         DateTime?
  totalLunchMinutes    Int           @default(0)
  totalDurationMinutes Int           @default(0)
  totalDistanceKm      Int           @default(0)
  status               String        @default("IN_PROGRESS") // "IN_PROGRESS" | "PAUSED_LUNCH" | "COMPLETED"
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle              Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver               User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entryChecklist       VehicleChecklist? @relation("EntryChecklist", fields: [entryChecklistId], references: [id], onDelete: SetNull)
  exitChecklist        VehicleChecklist? @relation("ExitChecklist", fields: [exitChecklistId], references: [id], onDelete: SetNull)
}

model TimeClocking {
  id        String        @id @default(uuid())
  tenantId  String
  userId    String
  type      String        // "ENTRADA" | "ALMOCO_SAIDA" | "ALMOCO_RETORNO" | "SAIDA"
  timestamp DateTime      @default(now())
  isOffline Boolean       @default(false)
  latitude  Float?
  longitude Float?
  createdAt DateTime      @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String
  userId     String?
  action     String      // "INICIO_ROTA" | "PAUSA_ALMOCO" | "RETOMADA_ALMOCO" | "FIM_ROTA" | "ALERTA_AVARIA" | "BATIDA_PONTO"
  entityType String
  entityId   String
  details    String?     // JSON string
  timestamp  DateTime    @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}
